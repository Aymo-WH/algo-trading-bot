{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/workspace/venv/bin/python /workspace/algo-trading-bot/.claude/hooks/quarantine_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/algo-trading-bot/.claude/hooks/fast_tests.sh"
          }
        ]
      }
    ]
  }
}
